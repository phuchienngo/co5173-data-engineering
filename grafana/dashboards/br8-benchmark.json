          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT formatDateTime(started_at, '%m-%d %H:%i:%S') AS `Started (UTC)`, what AS `What`, input_name AS `Input`,\n       variant AS `Settings`, hardware AS `Hardware`, status AS `Status`, round(duration_s, 1) AS `Time (s)`,\n       correct AS `Correct?`, visits AS `Visits`, places AS `Places`, toString(run_id) AS run_id, toString(run_id) AS ref_id, toUnixTimestamp64Milli(started_at) - 5000 AS from_ms, toUnixTimestamp64Milli(ifNull(finished_at, now64(3))) + 5000 AS to_ms\nFROM br8.run_history WHERE run_type = 'run' AND $__timeFilter(started_at) ORDER BY started_at DESC LIMIT 25",
          "refId": "A"
        }
