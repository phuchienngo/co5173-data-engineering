    {
      "type": "barchart",
      "title": "Steps per cell",
      "description": "Start-up: Spark session and executors, or the ClickHouse job's Python start.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT concat(block, ' ', cell) AS cell_name,\n       round(quantileExact(0.5)(outside_steps_s), 1) AS `Start-up (outside steps)`,\n       round(quantileExact(0.5)(step_durations['read']) / 1000, 1) AS `Read`,\n       round(quantileExact(0.5)(step_durations['clean']) / 1000, 1) AS `Clean`,\n       round(quantileExact(0.5)(step_durations['match']) / 1000, 1) AS `Match attractions`,\n       round(quantileExact(0.5)(step_durations['aggregate']) / 1000, 1) AS `Aggregate visits`,\n       round(quantileExact(0.5)(step_durations['write']) / 1000, 1) AS `Write`\nFROM br8.run_history WHERE run_type = 'run' AND $__timeFilter(started_at) AND block != '' AND repeat != 'warmup' AND status = 'succeeded'\nGROUP BY block, cell ORDER BY block, cell",
          "refId": "A"
        }
      ],
      "id": 17,
