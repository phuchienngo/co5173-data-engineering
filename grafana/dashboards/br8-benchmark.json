          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT concat(block, ' ', cell) AS `Cell`, any(variant) AS `Settings`,\n       round(quantileExact(0.5)(resources['spark.cpu_ms']) / 1000, 1) AS `CPU (s)`,\n       round(quantileExact(0.5)(resources['spark.gc_ms']) / 1000, 1) AS `GC (s)`,\n       toUInt32(quantileExact(0.5)(resources['spark.tasks'])) AS `Tasks`,\n       round(quantileExact(0.5)(resources['spark.shuffle_write_bytes']) / 1048576) AS `Shuffle (MB)`,\n       round(quantileExact(0.5)(resources['spark.spill_disk_bytes']) / 1048576) AS `Spill (MB)`,\n       round(quantileExact(0.5)(resources['spark.executor_peak_heap_bytes']) / 1048576) AS `Executor heap (MB)`,\n       round(quantileExact(0.5)(resources['spark.driver_peak_heap_bytes']) / 1048576) AS `Driver heap (MB)`\nFROM br8.run_history WHERE run_type = 'run' AND $__timeFilter(started_at) AND block != '' AND repeat != 'warmup' AND status = 'succeeded' AND engine = 'spark'\nGROUP BY block, cell ORDER BY block, cell",
          "refId": "A"
        }
