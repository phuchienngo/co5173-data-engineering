          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT concat(block, ' ', cell) AS `Cell`,\n       round(quantileExact(0.5)(resources['clickhouse.query_ms']) / 1000, 2) AS `Query time (s)`,\n       round(quantileExact(0.5)(resources['clickhouse.cpu_ms']) / 1000, 2) AS `CPU (s)`,\n       toUInt32(max(resources['clickhouse.peak_threads'])) AS `Peak threads`,\n       round(quantileExact(0.5)(resources['clickhouse.peak_memory_bytes']) / 1048576) AS `Peak memory (MB)`,\n       toUInt64(quantileExact(0.5)(resources['clickhouse.read_rows'])) AS `Rows read`\nFROM br8.run_history WHERE run_type = 'run' AND $__timeFilter(started_at) AND block != '' AND repeat != 'warmup' AND status = 'succeeded'\nGROUP BY block, cell ORDER BY block, cell",
