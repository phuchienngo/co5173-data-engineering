    {
      "type": "table",
      "title": "Cells",
      "description": "Spread above 15% (orange) gets a third run. Correct? is ✗ if any run of the cell gave another answer.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT block AS `Block`, any(hardware) AS `Hardware`, cell AS `Cell`, any(input_name) AS `Input`,\n       any(variant) AS `Settings`, countIf(status = 'succeeded') AS `OK runs`, countIf(status = 'failed') AS `Failed`,\n       round(quantileExact(0.5)(duration_s), 1) AS `Median (s)`, round(min(duration_s), 1) AS `Fastest (s)`,\n       round(max(duration_s), 1) AS `Slowest (s)`,\n       round(100 * (max(duration_s) / nullIf(min(duration_s), 0) - 1)) AS `Spread (%)`,\n       multiIf(countIf(correct = '✗ WRONG') > 0, '✗ WRONG', countIf(correct = '✓ correct') > 0, '✓ correct', '')\n           AS `Correct?`\nFROM br8.run_history WHERE run_type = 'run' AND $__timeFilter(started_at) AND block != '' AND repeat != 'warmup'\nGROUP BY block, cell ORDER BY block, cell",
          "refId": "A"
        }
      ],
      "id": 15,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
