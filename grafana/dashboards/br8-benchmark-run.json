    {
      "type": "table",
      "title": "Figures",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT name AS `Figure`, round(a.resources[key] / div, 1) AS `This run`,\n       round(r.resources[key] / div, 1) AS `Compared run`\nFROM (SELECT * FROM br8.run_history WHERE run_id = toUUIDOrZero('${run}')) AS a CROSS JOIN (SELECT * FROM br8.run_history WHERE run_id = toUUIDOrZero('${ref}')) AS r\nARRAY JOIN\n  ['spark.cpu_ms', 'spark.run_ms', 'spark.gc_ms', 'spark.tasks', 'spark.shuffle_write_bytes', 'spark.spill_disk_bytes',\n   'spark.executor_peak_heap_bytes', 'spark.driver_peak_heap_bytes', 'clickhouse.queries', 'clickhouse.query_ms',\n   'clickhouse.cpu_ms', 'clickhouse.peak_threads', 'clickhouse.peak_memory_bytes', 'clickhouse.read_rows'] AS key,\n  ['Spark CPU (s)', 'Spark task time (s)', 'Spark GC (s)', 'Spark tasks', 'Shuffle written (MB)', 'Spilled to disk (MB)',\n   'Executor peak heap (MB)', 'Driver peak heap (MB)', 'ClickHouse queries', 'ClickHouse query time (s)',\n   'ClickHouse CPU (s)', 'ClickHouse peak threads', 'ClickHouse peak memory (MB)', 'ClickHouse rows read'] AS name,\n  [1000, 1000, 1000, 1, 1048576, 1048576, 1048576, 1048576, 1, 1000, 1000, 1, 1048576, 1] AS div\nWHERE a.resources[key] != 0 OR r.resources[key] != 0",
          "refId": "A"
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "table",
      "title": "Rows the run excluded",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT reason AS `Reason`, a.rows_excluded[key] AS `This run`, r.rows_excluded[key] AS `Compared run`\nFROM (SELECT * FROM br8.run_history WHERE run_id = toUUIDOrZero('${run}')) AS a CROSS JOIN (SELECT * FROM br8.run_history WHERE run_id = toUUIDOrZero('${ref}')) AS r\nARRAY JOIN ['invalid', 'duplicate', 'unnamed_place', 'not_attraction'] AS key,\n           ['Invalid (user, place or time missing)', 'Duplicate check-in', 'Place without a name',\n            'Not an attraction'] AS reason",
          "refId": "A"
        }
      ],
      "id": 13,
