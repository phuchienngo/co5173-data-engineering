    {
      "type": "barchart",
      "title": "Seconds per step",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT step AS `Step`, round(a.step_durations[key] / 1000, 1) AS `This run`,\n       round(r.step_durations[key] / 1000, 1) AS `Compared run`\nFROM (SELECT * FROM br8.run_history WHERE run_id = toUUIDOrZero('${run}')) AS a CROSS JOIN (SELECT * FROM br8.run_history WHERE run_id = toUUIDOrZero('${ref}')) AS r\nARRAY JOIN ['read', 'clean', 'match', 'aggregate', 'write'] AS key,\n           ['Read', 'Clean', 'Match attractions', 'Aggregate visits', 'Write'] AS step\nUNION ALL\nSELECT 'Start-up (outside steps)', round(a.outside_steps_s, 1), round(r.outside_steps_s, 1)\nFROM (SELECT * FROM br8.run_history WHERE run_id = toUUIDOrZero('${run}')) AS a CROSS JOIN (SELECT * FROM br8.run_history WHERE run_id = toUUIDOrZero('${ref}')) AS r",
          "refId": "A"
        }
      ],
      "id": 9,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "table",
      "title": "Settings that differ",
      "description": "Empty: both runs used the same settings (pick another run in Compare with).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT key AS `Setting`, a.settings[key] AS `This run`, r.settings[key] AS `Compared run`\nFROM (SELECT * FROM br8.run_history WHERE run_id = toUUIDOrZero('${run}')) AS a CROSS JOIN (SELECT * FROM br8.run_history WHERE run_id = toUUIDOrZero('${ref}')) AS r\nARRAY JOIN arrayDistinct(arrayConcat(mapKeys(a.settings), mapKeys(r.settings))) AS key\nWHERE a.settings[key] != r.settings[key] AND NOT startsWith(key, 'effective.') AND key != 'launch.settings_from'\nORDER BY startsWith(key, 'cluster.'), key",
          "refId": "A"
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 11
