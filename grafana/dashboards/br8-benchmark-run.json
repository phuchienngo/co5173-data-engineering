    {
      "type": "table",
      "title": "The two runs",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT * FROM (\nSELECT 'This run' AS `Run`, what AS `What`, input_name AS `Input`, variant AS `Settings`, hardware AS `Hardware`,\n       status AS `Status`, round(duration_s, 1) AS `Time (s)`, correct AS `Correct?`, rows_read AS `Rows read`,\n       rows_used AS `Attraction check-ins`, visits AS `Visits`, places AS `Places`, spark_app_id AS `Spark app`,\n       error AS `Error`\nFROM (SELECT * FROM br8.run_history WHERE run_id = toUUIDOrZero('${run}'))\nUNION ALL\nSELECT 'Compared run', what, input_name, variant, hardware, status, round(duration_s, 1), correct, rows_read,\n       rows_used, visits, places, spark_app_id, error\nFROM (SELECT * FROM br8.run_history WHERE run_id = toUUIDOrZero('${ref}'))) ORDER BY `Run` = 'Compared run'",
          "refId": "A"
        }
      ],
