          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT place_name AS `Attraction`, city_name AS `City`, country_name AS `Country`, category AS `Category`,\n       visitors AS `Visitors`, returning_visitors AS `Came back`, visits AS `Visits`,\n       round(100 * returning_visitors / visitors, 1) AS `Repeat rate (%)`\nFROM br8.run_place WHERE run_id = toUUIDOrZero('${run}')\nORDER BY returning_visitors DESC, visitors DESC, place_id LIMIT 20",
          "refId": "A"
        }
