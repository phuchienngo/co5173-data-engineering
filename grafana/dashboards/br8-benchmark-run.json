        "query": "SELECT toString(run_id) AS __value, label AS __text FROM br8.run_history WHERE run_type = 'run' ORDER BY started_at DESC LIMIT 300",
        "definition": "SELECT toString(run_id) AS __value, label AS __text FROM br8.run_history WHERE run_type = 'run' ORDER BY started_at DESC LIMIT 300",
