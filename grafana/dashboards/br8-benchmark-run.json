    {
      "type": "stat",
      "title": "Against the compared run",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT multiIf(a.run_id = r.run_id, 'same run · pick another in Compare with',\n               a.duration_s IS NULL OR r.duration_s IS NULL, '—',\n               a.duration_s <= r.duration_s, concat(toString(round(r.duration_s / a.duration_s, 1)), '× faster'),\n               concat(toString(round(a.duration_s / r.duration_s, 1)), '× slower'))\nFROM (SELECT * FROM br8.run_history WHERE run_id = toUUIDOrZero('${run}')) AS a CROSS JOIN (SELECT * FROM br8.run_history WHERE run_id = toUUIDOrZero('${ref}')) AS r",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
