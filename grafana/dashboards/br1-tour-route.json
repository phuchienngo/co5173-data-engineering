          "editorType": "sql",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT round(median(s), 1) FROM (SELECT maxIf(seconds, run_mode = 'naive' AND stage = 'total') / nullIf(maxIf(seconds, run_mode = 'optimized' AND stage = 'total'), 0) AS s FROM tour.job_run GROUP BY ran_at HAVING s > 0 ORDER BY ran_at DESC LIMIT 3)",
