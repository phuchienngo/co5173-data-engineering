          "editorType": "sql",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT formatDateTime(ran_at, '%m-%d %H:%i') AS run, maxIf(seconds, run_mode = 'naive' AND stage = 'total') AS naive, maxIf(seconds, run_mode = 'optimized' AND stage = 'total') AS optimized FROM tour.job_run GROUP BY ran_at HAVING naive > 0 ORDER BY ran_at DESC LIMIT 10",
