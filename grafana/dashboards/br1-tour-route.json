      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT ran_at, any(requests) AS requests, maxIf(seconds, run_mode = 'naive' AND stage = 'requests') AS naive_requests_s, maxIf(seconds, run_mode = 'naive' AND stage = 'solve') AS naive_solve_s, maxIf(seconds, run_mode = 'naive' AND stage = 'total') AS naive_total_s, maxIf(seconds, run_mode = 'optimized' AND stage = 'requests') AS opt_requests_s, maxIf(seconds, run_mode = 'optimized' AND stage = 'solve') AS opt_solve_s, maxIf(seconds, run_mode = 'optimized' AND stage = 'total') AS opt_total_s, round(naive_total_s / nullIf(opt_total_s, 0), 1) AS speedup, maxIf(seconds, stage = 'dist_matrix') AS dist_matrix_s, maxIf(seconds, stage = 'sink_clickhouse') AS sink_clickhouse_s FROM tour.job_run GROUP BY ran_at HAVING naive_total_s > 0 ORDER BY ran_at DESC LIMIT 10",
          "refId": "A"
        }
      ],
      "title": "Benchmark runs (latest 10)",
      "type": "table"
