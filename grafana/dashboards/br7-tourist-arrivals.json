          "rawSql": "SELECT zone_name AS \"Khu\", landmark AS \"Địa danh tiêu biểu\", argMax(observed_hour_local, observed_hour) AS \"Giờ gần nhất (NY)\", argMax(observed_arrivals, observed_hour) AS \"Lượt đến giờ đó\", argMax(predicted_arrivals, observed_hour) AS \"Dự báo giờ tới\", argMax(warning_threshold, observed_hour) AS \"Ngưỡng cảnh báo\", argMax(multiIf(alert_level = 'warning', 'Cảnh báo', alert_level = 'normal', 'Bình thường', 'Chưa có mức chuẩn'), observed_hour) AS \"Trạng thái\" FROM v_br7_zone_hourly GROUP BY zone_name, landmark ORDER BY \"Dự báo giờ tới\" DESC",
