      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT zone_name, count() AS forecasts, round(100 * avg(abs_error / greatest(actual_arrivals, 1)), 1) AS mape_pct, countIf(alert_level = 'warning') AS warnings, countIf(alert_level = 'warning' AND actual_above_threshold = 1) AS warnings_confirmed, countIf(actual_above_threshold = 1) AS hours_above_threshold FROM v_br7_forecast_check WHERE actual_arrivals >= 20 GROUP BY zone_name ORDER BY warnings DESC",
