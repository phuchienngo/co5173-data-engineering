    {
      "id": 4,
      "title": "Forecast error (MAPE)",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT round(100 * avg(abs_error / greatest(actual_arrivals, 1)), 1) AS mape FROM v_br7_forecast_check WHERE actual_arrivals >= 20",
          "refId": "A"
        }
      ],
      "description": "Mean absolute percentage error of the next-hour forecast against the hour that actually followed (hours with at least 20 arrivals).",
      "options": {
        "reduceOptions": {
          "calcs": [
