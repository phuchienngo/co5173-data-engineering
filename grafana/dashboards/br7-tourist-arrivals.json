      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT zone_name, landmark, argMax(observed_hour_local, observed_hour) AS last_hour_local, argMax(observed_arrivals, observed_hour) AS last_hour_arrivals, argMax(predicted_arrivals, observed_hour) AS predicted_next_hour, argMax(warning_threshold, observed_hour) AS warning_threshold, argMax(alert_level, observed_hour) AS alert_level FROM v_br7_zone_hourly GROUP BY zone_name, landmark ORDER BY predicted_next_hour DESC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Forecast quality by zone",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
