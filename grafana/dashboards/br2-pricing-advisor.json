          "queryType": "sql",
          "rawSql": "SELECT landmark,\n       hour_of_day AS hour,\n       count() AS hours_seen,\n       round(100 * countIf(demand_ratio_pct > ${threshold}) / count(), 1) AS surge_share_pct,\n       round(avg(demand_ratio_pct), 1) AS avg_ratio_pct,\n       round(avg(avg_fare), 2) AS fare_usd,\n       round(avg(avg_fare) * (1 + ${uplift} / 100), 2) AS raised_fare_usd,\n       round(sumIf(active_bookings * avg_fare * ${uplift} / 100, demand_ratio_pct > ${threshold})) AS extra_revenue_usd\nFROM pricing.v_demand_ratio\nWHERE $__timeFilter(window_start) AND landmark IN (${landmark:singlequote}) AND source IN (${source:singlequote}) AND (${day_type:singlequote} = 'all' OR if(toDayOfWeek(window_start) >= 6, 'weekend', 'weekday') = ${day_type:singlequote})\nGROUP BY landmark, hour_of_day\nHAVING surge_share_pct >= 50\nORDER BY extra_revenue_usd DESC\nLIMIT 30",
          "refId": "A"
        }
      ],
      "title": "Best hours to raise prices",
      "type": "table"
