          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT landmark,\n       max(window_start) AS latest_hour,\n       argMax(active_bookings, window_start) AS bookings,\n       argMax(capacity, window_start) AS cap,\n       round(argMax(demand_ratio_pct, window_start), 1) AS ratio_pct,\n       round(argMax(avg_fare, window_start), 2) AS fare_usd,\n       round(if(ratio_pct > ${threshold}, fare_usd * (1 + ${uplift} / 100), fare_usd), 2) AS suggested_usd,\n       if(ratio_pct > ${threshold}, 'Raise ${uplift}%', 'Hold') AS action\nFROM pricing.v_demand_ratio\nWHERE $__timeFilter(window_start) AND landmark IN (${landmark:singlequote}) AND source IN (${source:singlequote}) AND (${day_type:singlequote} = 'all' OR if(toDayOfWeek(window_start) >= 6, 'weekend', 'weekday') = ${day_type:singlequote})\nGROUP BY landmark\nORDER BY ratio_pct DESC",
          "refId": "A"
        }
      ],
      "title": "Price suggestion per landmark (latest hour in range)",
      "type": "table"
    },
