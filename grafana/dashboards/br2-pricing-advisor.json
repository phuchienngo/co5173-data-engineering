          "rawSql": "SELECT landmark, round(avgIf(demand_ratio_pct, hour_of_day = 0)) AS h00, round(avgIf(demand_ratio_pct, hour_of_day = 1)) AS h01, round(avgIf(demand_ratio_pct, hour_of_day = 2)) AS h02, round(avgIf(demand_ratio_pct, hour_of_day = 3)) AS h03, round(avgIf(demand_ratio_pct, hour_of_day = 4)) AS h04, round(avgIf(demand_ratio_pct, hour_of_day = 5)) AS h05, round(avgIf(demand_ratio_pct, hour_of_day = 6)) AS h06, round(avgIf(demand_ratio_pct, hour_of_day = 7)) AS h07, round(avgIf(demand_ratio_pct, hour_of_day = 8)) AS h08, round(avgIf(demand_ratio_pct, hour_of_day = 9)) AS h09, round(avgIf(demand_ratio_pct, hour_of_day = 10)) AS h10, round(avgIf(demand_ratio_pct, hour_of_day = 11)) AS h11, round(avgIf(demand_ratio_pct, hour_of_day = 12)) AS h12, round(avgIf(demand_ratio_pct, hour_of_day = 13)) AS h13, round(avgIf(demand_ratio_pct, hour_of_day = 14)) AS h14, round(avgIf(demand_ratio_pct, hour_of_day = 15)) AS h15, round(avgIf(demand_ratio_pct, hour_of_day = 16)) AS h16, round(avgIf(demand_ratio_pct, hour_of_day = 17)) AS h17, round(avgIf(demand_ratio_pct, hour_of_day = 18)) AS h18, round(avgIf(demand_ratio_pct, hour_of_day = 19)) AS h19, round(avgIf(demand_ratio_pct, hour_of_day = 20)) AS h20, round(avgIf(demand_ratio_pct, hour_of_day = 21)) AS h21, round(avgIf(demand_ratio_pct, hour_of_day = 22)) AS h22, round(avgIf(demand_ratio_pct, hour_of_day = 23)) AS h23 FROM pricing.v_demand_ratio WHERE $__timeFilter(window_start) AND landmark IN (${landmark:singlequote}) AND source IN (${source:singlequote}) AND (${day_type:singlequote} = 'all' OR if(toDayOfWeek(window_start) >= 6, 'weekend', 'weekday') = ${day_type:singlequote}) GROUP BY landmark ORDER BY landmark",
