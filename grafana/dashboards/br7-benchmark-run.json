          "rawSql": "SELECT zone_name AS `Zone`, borough AS `Borough`, landmark AS `Landmark`, replay_events AS `Replay drop-offs`\nFROM br7.run_zone WHERE run_id = toUUIDOrZero('${run}') ORDER BY replay_events DESC",
