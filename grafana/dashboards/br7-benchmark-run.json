    {
      "type": "table",
      "title": "Busiest usual hours (baseline, New York time)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT z.zone_name AS `Zone`,\n       concat(['Mon','Tue','Wed','Thu','Fri','Sat','Sun'][intDiv(b.hour_of_week, 24) + 1], ' ',\n              leftPad(toString(b.hour_of_week % 24), 2, '0'), ':00') AS `Hour`,\n       b.mean_arrivals AS `Usual drop-offs`, b.p90_arrivals AS `Warning level (p90)`, b.training_hours AS `Hours seen`\nFROM br7.run_baseline AS b\nLEFT JOIN (SELECT zone_id, zone_name FROM br7.run_zone WHERE run_id = toUUIDOrZero('${run}')) AS z\n    ON z.zone_id = b.zone_id\nWHERE b.run_id = toUUIDOrZero('${run}')\nORDER BY b.mean_arrivals DESC LIMIT 20",
          "refId": "A"
        }
      ],
