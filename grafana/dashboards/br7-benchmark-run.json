    {
      "type": "barchart",
      "title": "Seconds per step",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT step AS `Step`, round(a.step_durations[key] / 1000, 1) AS `This run`,\n       round(r.step_durations[key] / 1000, 1) AS `Compared run`\nFROM (SELECT * FROM br7.run_history WHERE run_id = toUUIDOrZero('${run}')) AS a CROSS JOIN (SELECT * FROM br7.run_history WHERE run_id = toUUIDOrZero('${ref}')) AS r\nARRAY JOIN ['quality', 'clean', 'baseline', 'replay', 'write'] AS key,\n           ['Read + quality labels', 'Clean + duplicates', 'Baseline', 'Replay', 'Write'] AS step\nUNION ALL\nSELECT 'Start-up (outside steps)', round(a.outside_steps_s, 1), round(r.outside_steps_s, 1)\nFROM (SELECT * FROM br7.run_history WHERE run_id = toUUIDOrZero('${run}')) AS a CROSS JOIN (SELECT * FROM br7.run_history WHERE run_id = toUUIDOrZero('${ref}')) AS r",
          "refId": "A"
        }
