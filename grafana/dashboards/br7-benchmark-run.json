      }
    },
    {
      "type": "table",
      "title": "Rows the run excluded",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT reason AS `Reason`, a.rows_excluded[key] AS `This run`, r.rows_excluded[key] AS `Compared run`\nFROM (SELECT * FROM br7.run_history WHERE run_id = toUUIDOrZero('${run}')) AS a CROSS JOIN (SELECT * FROM br7.run_history WHERE run_id = toUUIDOrZero('${ref}')) AS r\nARRAY JOIN ['missing_field', 'dropoff_outside_file_month', 'dropoff_not_after_pickup', 'trip_longer_than_6h',\n            'invalid_distance', 'nonpositive_amount', 'outside_tourist_zones', 'duplicate'] AS key,\n           ['Field missing', 'Drop-off outside the file month', 'Drop-off not after pick-up', 'Trip longer than 6 h',\n            'Invalid distance', 'Amount not positive', 'Not dropped off in a tourist zone', 'Duplicate trip'] AS reason",
          "refId": "A"
        }
      ],
