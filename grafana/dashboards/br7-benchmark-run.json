    {
      "type": "table",
      "title": "Settings that differ",
      "description": "Empty: both runs used the same settings (pick another run in Compare with).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT key AS `Setting`, a.settings[key] AS `This run`, r.settings[key] AS `Compared run`\nFROM (SELECT * FROM br7.run_history WHERE run_id = toUUIDOrZero('${run}')) AS a CROSS JOIN (SELECT * FROM br7.run_history WHERE run_id = toUUIDOrZero('${ref}')) AS r\nARRAY JOIN arrayDistinct(arrayConcat(mapKeys(a.settings), mapKeys(r.settings))) AS key\nWHERE a.settings[key] != r.settings[key] AND NOT startsWith(key, 'effective.') AND key != 'launch.settings_from'\nORDER BY startsWith(key, 'cluster.'), key",
          "refId": "A"
        }
