          "queryType": "table",
          "rawSql": "SELECT d.place_name, r.user_id, r.visit_count, r.first_visit, r.last_visit FROM v_br8_user_retention AS r INNER JOIN dim_br8_places AS d ON r.place_id = d.place_id WHERE r.has_returned = 1 ORDER BY r.visit_count DESC, d.place_name, r.user_id LIMIT 100",
