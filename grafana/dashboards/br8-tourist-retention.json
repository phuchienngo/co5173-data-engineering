    {
      "id": 7,
      "title": "Khách quay lại tăng như thế nào theo thời gian?",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 14,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "time series",
          "rawSql": "WITH daily AS (SELECT visit_date, sum(new_visitors) AS new_visitors, sum(new_returning) AS new_returning FROM (SELECT first_visit AS visit_date, toUInt64(1) AS new_visitors, toUInt64(0) AS new_returning FROM v_br8_user_retention UNION ALL SELECT visit_days[2] AS visit_date, toUInt64(0) AS new_visitors, toUInt64(1) AS new_returning FROM v_br8_user_retention WHERE has_returned = 1) GROUP BY visit_date) SELECT toDateTime(visit_date, 'UTC') AS time, round(100.0 * sum(new_returning) OVER w / nullIf(sum(new_visitors) OVER w, 0), 2) AS repeat_visit_rate FROM daily WINDOW w AS (ORDER BY visit_date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "spanNulls": true,
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "axisLabel": "Tỷ lệ (%)",
            "axisBorderShow": false,
            "axisColorMode": "text",
            "axisPlacement": "left",
            "gradientMode": "opacity"
          },
          "displayName": "Tỷ lệ quay lại",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Tỷ lệ quay lại tính từ đầu dữ liệu đến từng ngày: khách bắt đầu được tính khi ghé lần đầu và được tính là quay lại khi ghé vào ngày khác. Đường hiển thị trong khoảng thời gian đang chọn."
    },
