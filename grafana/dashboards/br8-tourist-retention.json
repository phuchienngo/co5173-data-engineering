          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT place_name, city_name, country_name, unique_visitors, returning_visitors, total_visits, repeat_visit_rate, first_observed_date, last_observed_date FROM v_br8_place_retention ORDER BY repeat_visit_rate DESC, unique_visitors DESC",
