      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "time series",
          "rawSql": "SELECT toDateTime(r.visit_date, 'UTC') AS time, d.place_name AS attraction, r.repeat_visit_rate FROM v_br8_daily_retention AS r INNER JOIN dim_br8_places AS d ON r.place_id = d.place_id ORDER BY time, attraction",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "spanNulls": true
