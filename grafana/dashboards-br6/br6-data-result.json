    {
      "type": "barchart",
      "title": "Check-ins stored per city",
      "description": "Rows in the fact table per city. Check-ins without a location or of a place type that isn't offered are stored too; a run excludes them.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT c.city_name AS city, f.checkins AS `check-ins (all copies)`\nFROM br6.dim_city AS c\nJOIN (SELECT city_key, count() AS checkins FROM br6.fact_checkin GROUP BY city_key) AS f USING city_key\nORDER BY f.checkins DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "city",
        "orientation": "horizontal",
        "stacking": "none",
        "showValue": "never",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "xTickLabelRotation": 0,
        "xTickLabelMaxLength": 40,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 30,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      }
    },
    {
      "type": "table",
      "title": "Cities",
      "description": "Per city, in the original data (one copy): check-ins, check-ins without a location, places, places with a location, different visitors.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT c.city_name AS city, c.country_name AS country, r.checkins AS checkins,\n       r.no_location AS without_location, p.places AS places, p.located AS places_with_location,\n       v.visitors AS visitors\nFROM br6.dim_city AS c\nLEFT JOIN (SELECT city, count() AS checkins, countIf(latitude IS NULL) AS no_location\n           FROM br6.raw_checkin GROUP BY city) AS r ON r.city = c.city_code\nLEFT JOIN (SELECT city_key, count() AS places, countIf(latitude IS NOT NULL) AS located\n           FROM br6.dim_place GROUP BY city_key) AS p ON p.city_key = c.city_key\nLEFT JOIN (SELECT city_key, count() AS visitors FROM br6.dim_visitor GROUP BY city_key) AS v\n       ON v.city_key = c.city_key\nORDER BY checkins DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
