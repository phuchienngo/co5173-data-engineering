          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT replaceAll(k, '_', ' ') AS reason, v AS checkins FROM br6.run_history\nARRAY JOIN mapKeys(rows_excluded) AS k, mapValues(rows_excluded) AS v\nWHERE run_id = (SELECT run_id FROM br6.run_history WHERE run_type = 'run' AND status = 'succeeded' ORDER BY started_at DESC LIMIT 1) ORDER BY checkins DESC",
