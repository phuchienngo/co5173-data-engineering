    {
      "type": "table",
      "title": "Choices",
      "description": "The latest succeeded Route Finder run (any choice).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT started_at AS time, city, route, visitor, types, variant, multiplier,\n       round(duration_s, 1) AS duration_s, round(route_km, 1) AS route_km,\n       JSONExtractString(result_summary, 'message') AS message, toString(run_id) AS run_id\nFROM (SELECT * FROM br6.run_history WHERE run_id = (SELECT run_id FROM br6.run_history WHERE run_type = 'run' AND status = 'succeeded' ORDER BY started_at DESC LIMIT 1))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
