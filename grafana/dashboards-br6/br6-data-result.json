          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT rank, name, place_type, category_name AS category, round(detour_km, 2) AS detour_km,\n       round(position_km, 1) AS km_along_route, visitors, checkins, round(score, 3) AS score\nFROM br6.run_place WHERE run_id = (SELECT run_id FROM br6.run_history WHERE run_type = 'run' AND status = 'succeeded' ORDER BY started_at DESC LIMIT 1) AND rank > 0 ORDER BY rank",
          "refId": "A"
        }
