    {
      "type": "table",
      "title": "Imports",
      "description": "Every import in the time range.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT started_at AS time, status, criteria['cities'] AS cities, multiplier,\n       settings['pipeline.writer'] AS writer, round(duration_s, 1) AS duration_s,\n       rows_read, rows_written, toString(run_id) AS run_id, spark_app_id, error\nFROM br6.run_history WHERE run_type = 'import' AND $__timeFilter(started_at) ORDER BY started_at DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in the app's Run History",
                    "targetBlank": true,
                    "url": "http://localhost:8501/route_run_history?run=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "spark_app_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the run's Spark page",
                    "targetBlank": true,
                    "url": "http://localhost:18080/history/${__value.raw}/jobs/"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "succeeded": {
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "color": "red",
                        "index": 1
                      },
                      "running": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
