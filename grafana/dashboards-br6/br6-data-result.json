          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT status, places FROM (\nSELECT arrayJoin([('suggested', suggested), ('below the top N', below_top_n), ('few visitors', few_visitors),\n                  ('type not chosen', type_not_chosen), ('not offered', not_offered)]) AS s,\n       s.1 AS status, s.2 AS places\nFROM br6.run_history WHERE run_id = (SELECT run_id FROM br6.run_history WHERE run_type = 'run' AND status = 'succeeded' ORDER BY started_at DESC LIMIT 1))",
          "refId": "A"
