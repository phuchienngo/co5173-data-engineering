    {
      "type": "table",
      "title": "Stored tables",
      "description": "Tables of the br6 database. The data tables are replaced by each import; pipeline_runs, settings, run_point and run_place are kept.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT name AS table, total_rows AS rows, formatReadableSize(total_bytes) AS size\nFROM system.tables WHERE database = 'br6' AND engine LIKE '%MergeTree' ORDER BY name",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 7,
