    {
      "type": "barchart",
      "title": "Rows excluded per reason",
      "description": "Cleaning rules of the latest run. 'kept' rows are counted but still used (unknown country; price 0 or below, left out of the average price).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT multiIf(reason = 'kept_unknown_country', 'kept: no country', reason = 'kept_no_price', 'kept: no price',\n               replaceOne(reason, '_', ' ')) AS reason, rows FROM (\nSELECT k AS reason, v AS rows FROM br5.run_history\nARRAY JOIN mapKeys(rows_excluded) AS k, mapValues(rows_excluded) AS v\nWHERE run_id = (SELECT run_id FROM br5.run_history WHERE run_type = 'analysis' AND status = 'succeeded' ORDER BY started_at DESC LIMIT 1)) ORDER BY startsWith(reason, 'kept'), rows DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "reason",
        "orientation": "horizontal",
        "stacking": "none",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "xTickLabelRotation": 0,
        "xTickLabelMaxLength": 40,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
