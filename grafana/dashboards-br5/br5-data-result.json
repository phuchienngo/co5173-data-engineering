          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT target_rank AS rank, room_type, country_name AS country, when_text AS low_season,\n       round(potential, 1) AS potential_room_nights, discount, arrayStringConcat(offers, '; ') AS offers,\n       arrayStringConcat(channels, ', ') AS channels\nFROM br5.run_card WHERE run_id = (SELECT run_id FROM br5.run_history WHERE run_type = 'analysis' AND status = 'succeeded' ORDER BY started_at DESC LIMIT 1) ORDER BY rank",
          "refId": "A"
        }
