          "queryType": "table",
          "rawSql": "SELECT started_at AS time, status, multiplier, settings['pipeline.writer'] AS writer, round(duration_s, 1) AS duration_s,\n       rows_read, rows_written, toString(run_id) AS run_id, spark_app_id, error\nFROM br5.run_history WHERE run_type = 'import' AND $__timeFilter(started_at) ORDER BY started_at DESC",
