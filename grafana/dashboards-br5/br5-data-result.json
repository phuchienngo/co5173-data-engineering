          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT name AS table, total_rows AS rows, formatReadableSize(total_bytes) AS size\nFROM system.tables WHERE database = 'br5' AND engine LIKE '%MergeTree' ORDER BY name",
          "refId": "A"
