    {
      "type": "table",
      "title": "Choice and low season",
      "description": "The latest succeeded analysis run (any choice).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT started_at AS time, choice, variant, multiplier, round(duration_s, 1) AS duration_s,\n       arrayStringConcat(JSONExtract(result_summary, 'season_texts', 'Array(String)'), '; ') AS low_season,\n       JSONExtractString(result_summary, 'message') AS message, result_count AS cards\nFROM br5.run_history WHERE run_id = (SELECT run_id FROM br5.run_history WHERE run_type = 'analysis' AND status = 'succeeded' ORDER BY started_at DESC LIMIT 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": []
