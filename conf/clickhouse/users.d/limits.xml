<clickhouse>
    <profiles>
        <default>
            <!-- Set ClickHouse memory limits for local workloads. -->
            <max_memory_usage>4000000000</max_memory_usage>
            <max_memory_usage_for_user>6000000000</max_memory_usage_for_user>

            <!-- Set ClickHouse memory limits for local workloads. -->
            <max_bytes_before_external_group_by>2000000000</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>2000000000</max_bytes_before_external_sort>

            <max_execution_time>300</max_execution_time>
            <max_result_rows>1000000</max_result_rows>
            <result_overflow_mode>throw</result_overflow_mode>

            <!-- Set ClickHouse memory limits for local workloads. -->
            <max_insert_block_size>1048576</max_insert_block_size>
            <min_insert_block_size_rows>100000</min_insert_block_size_rows>

            <!-- Set ClickHouse memory limits for local workloads. -->
            <input_format_skip_unknown_fields>1</input_format_skip_unknown_fields>

            <!-- Set ClickHouse memory limits for local workloads. -->
            <date_time_input_format>best_effort</date_time_input_format>
        </default>
    </profiles>

    <quotas>
        <default>
            <!-- Set ClickHouse memory limits for local workloads. -->
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
